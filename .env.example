# chatty-web local settings. Copy to .env and change what you need: Copy-Item .env.example .env
# Variables starting with VITE_ are built into the app and visible in the browser: never put secrets in them.

# API base paths used by the browser (default: same origin, through the Vite proxy or Nginx)
VITE_CORE_API_URL=/api/core/v1
VITE_CHAT_API_URL=/api/chat/v1

# Where the Vite dev server forwards /api/core and /api/chat (npm run dev only)
CORE_API_TARGET=http://127.0.0.1:8000
CHAT_API_TARGET=http://127.0.0.1:8001
