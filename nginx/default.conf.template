# The nginx image fills in ${CORE_API_UPSTREAM} and ${CHAT_API_UPSTREAM} at startup.
# Standard map for WebSocket upgrades: sends "upgrade" on WS requests, "" otherwise.
# Forwarding $http_connection directly would pass "keep-alive" to the upstream, which
# prevents the WebSocket handshake from completing.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

# The image's default "main" format logs $request, which holds the query string, and the
# WebSocket sends the access token there (/api/chat/v1/ws?token=...). $uri is the path only.
log_format main_no_query '$remote_addr - $remote_user [$time_local] '
                         '"$request_method $uri $server_protocol" $status $body_bytes_sent '
                         '"$http_referer" "$http_user_agent" "$http_x_forwarded_for"';

server {
    listen 80;
    root /usr/share/nginx/html;
    access_log /var/log/nginx/access.log main_no_query;

    # Docker's DNS. With variables in proxy_pass, Nginx starts even if a backend isn't running yet.
    resolver 127.0.0.11 valid=10s;
    set $core ${CORE_API_UPSTREAM};
    set $chat ${CHAT_API_UPSTREAM};
    # Only our own files, styles inline too (React style props, sonner's injected <style>).
    # connect-src: the API and WebSocket ('self' covers ws:/wss: to this host), plus jsDelivr,
    # where the emoji picker (frimousse) loads its emoji data from.
    set $csp "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://cdn.jsdelivr.net; frame-ancestors 'none'";

    # Security headers. A location with its own add_header drops all of these, so the two
    # locations below repeat them. Change all three copies together.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy $csp always;

    location /api/core/ {
        proxy_pass $core;
        proxy_set_header Host $host;
        # Overwrites any X-Real-IP the client sent; the backends trust only this value (D-09).
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/chat/ {
        proxy_pass $chat;
        proxy_http_version 1.1;
        # WebSocket (GET /api/chat/v1/ws)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        # Overwrites any X-Real-IP the client sent; the backends trust only this value (D-09).
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 1h;
    }

    location = /health/core {
        proxy_pass $core/health;
    }

    location = /health/chat {
        proxy_pass $chat/health;
    }

    # Built files get a hash in their name, so they can be cached for a long time.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy $csp always;
    }

    # Single-page app: every other path loads index.html, and React Router shows the page.
    # no-cache so browsers always revalidate: after a deploy, index.html references new asset
    # hashes and an old cached copy would 404 on every script/style it tries to load.
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy $csp always;
        try_files $uri /index.html;
    }
}
