# The nginx image fills in ${CORE_API_UPSTREAM} and ${CHAT_API_UPSTREAM} at startup.
server {
    listen 80;
    root /usr/share/nginx/html;

    # Docker's DNS. With variables in proxy_pass, Nginx starts even if a backend isn't running yet.
    resolver 127.0.0.11 valid=10s;
    set $core ${CORE_API_UPSTREAM};
    set $chat ${CHAT_API_UPSTREAM};

    location /api/core/ {
        proxy_pass $core;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/chat/ {
        proxy_pass $chat;
        proxy_http_version 1.1;
        # WebSocket (GET /api/chat/v1/ws)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 1h;
    }

    location = /health/core {
        proxy_pass $core/health;
    }

    location = /health/chat {
        proxy_pass $chat/health;
    }

    # Built files get a hash in their name, so they can be cached for a long time.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Single-page app: every other path loads index.html, and React Router shows the page.
    location / {
        try_files $uri /index.html;
    }
}
